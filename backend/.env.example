# =============================================================================
# Orb — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Keys marked REQUIRED must be set. Keys marked OPTIONAL have working defaults.
#
# Desktop (Orb app) is the supported product path:
#   - First-run wizard writes DATA_DIR / MODELS_DIR into paths.json
#   - Supervisor starts local binaries (Qdrant, Meilisearch, Firefly, API, UI)
#   - Chat / embed / rerank / Qwen3-ASR / Marlin load in-process
#   - Note bodies are vault .md files; SQLite holds metadata only
#
# Contributors may still point LLM_PROVIDER at cloud APIs for experimentation.
#
# ── How providers work ────────────────────────────────────────────────────────
# Three components each have their own provider:
#   Chat/retrieval  → LLM_PROVIDER + CHAT_MODEL
#   Ingestion       → INGESTION_PROVIDER + INGESTION_MODEL  (defaults to LLM_* if omitted)
#   Embeddings      → EMBEDDING_PROVIDER + EMBEDDING_MODEL
#
# Supported LLM_PROVIDER values:
#   "local"      — in-process GGUF (desktop default)
#   "openai"     — OpenAI API
#   "gemini"     — Google Gemini API
#   "anthropic"  — Anthropic Claude API
#   "huggingface"— HuggingFace Inference API
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# CLOUD API KEYS ARE NO LONGER SET HERE.
#
# Enter them in the app: Settings → Cloud API keys. They are encrypted into the
# OS keychain (Electron safeStorage) and pushed into the running API; they are
# never written to DATA_DIR, which is often a synced folder.
#
# The *_API_KEY entries below still work for contributors running the backend
# outside the desktop shell (Docker / bare uvicorn). They seed the credential
# store at startup and show up in the UI as "from environment".
# ─────────────────────────────────────────────────────────────────────────────


# =============================================================================
# QUICK-START EXAMPLES  (uncomment ONE block, delete the rest)
# =============================================================================

# ── Option A: Desktop / in-process GGUF (recommended) ─────────────────────────
# Models live under MODELS_DIR; Orb downloads GGUFs from Setup.
# Supervisor/API load chat, embed, and rerank in-process (one heavy model at a time).
#
# LLM_PROVIDER=local
# CHAT_MODEL=gemma-4-e4b
# INGESTION_MODEL=gemma-4-e4b
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=qwen3-embedding-0.6b

# ── Option B: Cloud Gemini for chat + local embeddings ────────────────────────
#
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=AIza...               # https://aistudio.google.com/app/apikey
# CHAT_MODEL=gemini-2.5-pro
#
# INGESTION_PROVIDER=gemini
# INGESTION_MODEL=gemini-2.0-flash
#
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=qwen3-embedding-0.6b

# ── Option C: OpenAI for everything ───────────────────────────────────────────
#
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-proj...            # https://platform.openai.com/api-keys
# CHAT_MODEL=gpt-4o
#
# INGESTION_MODEL=gpt-4o               # or omit to share CHAT_MODEL via OPENAI_MODEL
#
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small

# ── Option D: Anthropic Claude for chat ───────────────────────────────────────
#
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...         # https://console.anthropic.com/
# CHAT_MODEL=claude-opus-4-5
#
# INGESTION_MODEL=claude-haiku-3-5     # cheaper model for bulk extraction
#
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=qwen3-embedding-0.6b


# =============================================================================
# FULL REFERENCE — every supported key with its default
# =============================================================================

# -----------------------------------------------------------------------------
# PATHS  (desktop wizard / supervisor normally set these)
# -----------------------------------------------------------------------------
# DATA_DIR=                            # SQLite, Qdrant, Meili, Kuzu, vaults, logs
# MODELS_DIR=                          # GGUF + HF multimodal snapshots

# -----------------------------------------------------------------------------
# EXTERNAL API KEYS  (REQUIRED if you use those providers or features)
# -----------------------------------------------------------------------------
# GEMINI_API_KEY=AIza...
# OPENAI_API_KEY=sk-proj-...
# ANTHROPIC_API_KEY=sk-ant-...
# HUGGINGFACE_API_KEY=hf_...

# -----------------------------------------------------------------------------
# CHAT / RETRIEVAL LLM
# -----------------------------------------------------------------------------
LLM_PROVIDER=local                     # local | openai | gemini | anthropic | huggingface

# Optional OpenAI-compatible HTTP (cloud / contrib). Desktop in-process GGUF ignores these.
# LLM_BASE_URL=http://127.0.0.1:1234
# LLM_API_KEY=
# LLM_KEEP_ALIVE=10m
# LLM_RESPONSE_FORMAT=text              # "text" or "json_object"

# Provider-agnostic model key — set this and it works for any LLM_PROVIDER
CHAT_MODEL=                           # e.g. gemini-2.5-pro / gpt-4o / claude-opus-4-5 / gemma-4-e4b

# Provider-specific fallback keys (used only when CHAT_MODEL is not set)
# LLM_MODEL=google/gemma-4-e4b        # local provider
# GEMINI_MODEL=gemini-2.5-pro
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_MODEL=claude-opus-4-5
# HUGGINGFACE_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Optional fallback provider if primary fails
# LLM_FALLBACK_PROVIDER=

# -----------------------------------------------------------------------------
# INGESTION LLM  (extraction, entity reasoning, image captioning)
# -----------------------------------------------------------------------------
# Leave all INGESTION_* blank to share the main LLM settings above.
# Set any of these to route ingestion to a different provider or model.

INGESTION_PROVIDER=                    # e.g. "local" — defaults to LLM_PROVIDER if blank

# Provider-agnostic model key — same idea as CHAT_MODEL
INGESTION_MODEL=                       # e.g. google/gemma-4-e4b / gemini-2.0-flash / gpt-4o-mini

# Provider-specific fallback keys (used only when INGESTION_MODEL is not set)
# INGESTION_LLM_MODEL=google/gemma-4-e4b   # local provider
# INGESTION_GEMINI_MODEL=gemini-2.0-flash  # Gemini provider

# Full-note ingestion is FIFO by default: one note completes multimedia,
# LLM extraction, graph writes, and indexing before the next note starts.
INGESTION_PIPELINE_CONCURRENCY=1
# Heavy local multimedia/model jobs are also serialized within each note.
MULTIMEDIA_CONCURRENCY=1

# -----------------------------------------------------------------------------
# EMBEDDINGS
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=local               # local | openai — desktop uses in-process GGUF
# EMBEDDING_BASE_URL=                  # only for OpenAI-compatible HTTP embed servers
# EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3-embedding-0.6b
EMBEDDING_DIMENSIONS=1024             # Must match the model's actual output dimensions

# -----------------------------------------------------------------------------
# DATA STORES  (desktop supervisor starts local binaries under DATA_DIR)
# -----------------------------------------------------------------------------
# Metadata: SQLite at {DATA_DIR}/orb.db (default). Note bodies are vault .md files.
# Optional Postgres URLs are contributor-only (Docker); leave unset for Orb desktop.
# DATABASE_TRANSACTION_POOLER_URL=postgresql://user:password@127.0.0.1:15432/orb
# DATABASE_SESSION_POOLER_URL=postgresql://user:password@127.0.0.1:15432/orb
# DATABASE_DIRECT_CONNECTION_URL=postgresql://user:password@127.0.0.1:15432/orb

# Kuzu (embedded graph — path under DATA_DIR)
KUZU_DB_PATH=data/kuzu/kuzu_graph

# Qdrant (vector SoT)
# QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
# QDRANT_API_KEY=                      # Only needed for Qdrant Cloud

# Meilisearch (keyword / BM25)
# MEILI_HOST=127.0.0.1
MEILI_PORT=7700
MEILI_MASTER_KEY=orb-dev-key
MEILI_INDEX_NAME=orb_nodes
# Legacy aliases (still accepted): TYPESENSE_HOST / TYPESENSE_PORT / TYPESENSE_API_KEY / TYPESENSE_COLLECTION_NAME

# Attachments / note files: per-KB vault on disk (served at /vault-files/...).

# -----------------------------------------------------------------------------
# EMBEDDED FIREFLY III  (desktop supervisor usually injects these automatically)
# -----------------------------------------------------------------------------
# FIREFLY_BASE_URL=http://127.0.0.1:17412
# FIREFLY_RUNTIME_FILE=/absolute/path/to/Application Support/Orb/data/firefly/runtime.json
# FIREFLY_API_TOKEN=                   # Optional override; normally read from runtime.json

# CORS is only needed when browsers call the backend directly on a separate
# origin. The Electron shell proxies the API, so CORS is normally unused.
# CORS_ORIGINS=http://localhost:3700,http://localhost:3701,https://your-domain.com
# CORS_ALLOW_ORIGIN_REGEX=

# -----------------------------------------------------------------------------
# LOCAL ML MODELS  (under MODELS_DIR / MODELS_PATH)
# -----------------------------------------------------------------------------
MODELS_PATH=models                     # Relative to backend/ when MODELS_DIR unset

# Vision (image understanding / OCR)
MODEL_FLORENCE_HF=microsoft/Florence-2-large
MODEL_FLORENCE_LOCAL=florence-2-large
# Cap Florence input size (width×height). 0 = full resolution.
FLORENCE_MAX_IMAGE_PIXELS=1500000

# PDF visual extraction renders every scanned/image-heavy page that needs
# Florence when this is 0.
PDF_VISUAL_EXTRACTION_ENABLED=true
PDF_VISUAL_EXTRACTION_MAX_PAGES=0
PDF_VISUAL_RENDER_DPI=144
PDF_VISUAL_TEXT_THRESHOLD=80

# Audio transcription
# Transcription (Qwen3-ASR). Leave empty to pick the layout per platform.
MODEL_ASR_HF=
MODEL_ASR_LOCAL=
ASR_ENGINE=auto
ASR_LANGUAGE=en

# Video visual understanding (in-process Marlin via multimodal_runtime)
MODEL_MARLIN_HF=lunahr/Marlin-2B-ungated
MODEL_MARLIN_LOCAL=marlin-2b
VIDEO_MAX_PIXELS=200704
FPS=2.0
FPS_MAX_FRAMES=240
FPS_MIN_FRAMES=4

# Reranker (improves retrieval quality — in-process GGUF)
MODEL_RERANKER_LOCAL=qwen3-reranker-0.6b

# In-process GGUF context (desktop / local). One model loaded at a time.
# Gemma 4 on Metal: swa_full=true + 16k ctx (32k OOMs; compact SWA → ordinal loops).
# ORB_LLAMA_N_CTX=16384
# ORB_LLAMA_MAX_TOKENS=10240
# ORB_LLAMA_SWA_FULL=true
# ORB_LLAMA_REPEAT_PENALTY=1.12
# ORB_LLAMA_PROMPT_RESERVE=4096
# ORB_EMBED_N_CTX=8192
# ORB_RERANK_N_CTX=8192

# -----------------------------------------------------------------------------
# RETRIEVAL TUNING  (safe to leave at defaults)
# -----------------------------------------------------------------------------
VECTOR_SIMILARITY_THRESHOLD=0.50      # Minimum score for vector search results
VECTOR_PRE_RERANK_THRESHOLD=0.45      # Score threshold before passing to reranker
RERANKER_ENABLED=true
RERANKER_TOP_K=10                     # Candidates kept after reranking
RERANKER_SCORE_THRESHOLD=0.05         # Drop reranked candidates below this score
GRAPH_EXPAND_TOP_NEIGHBORS=10
GRAPH_EXPAND_SCORE_THRESHOLD=0
MAX_POTENTIAL_QUESTIONS=10
MAX_LOOP_ITERATIONS=3

# Feature switches
COMMUNITY_DETECTION_ENABLED=true      # Set to false to disable community detection endpoint and post-ingestion trigger
TEMPORAL_DIGESTS_ENABLED=true         # Set to false to disable the temporal digest build endpoint
TEMPORAL_DIGEST_PERIOD=month          # Default granularity: month | week | year


# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR | CRITICAL


# =============================================================================
# PROVIDER NOTES
# =============================================================================
#
# LOCAL (desktop in-process GGUF via llama-cpp-python):
#   Free, private — nothing leaves your machine
#   Works offline once models are downloaded
#   Requires a GPU or powerful CPU for reasonable speed
#   Quality depends on which open model you load
#
# GOOGLE GEMINI:
#   Excellent quality, very fast
#   Free tier available (rate-limited)
#   Data sent to Google servers
#   Get key: https://aistudio.google.com/app/apikey
#
# OPENAI:
#   Top-tier quality (GPT-4o, o1)
#   Pay per token — can get expensive for ingestion
#   Data sent to OpenAI servers
#   Get key: https://platform.openai.com/api-keys
#
# ANTHROPIC CLAUDE:
#   Excellent reasoning and writing quality
#   No embedding API — pair with local GGUF embeddings
#   Pay per token; data sent to Anthropic servers
#   Get key: https://console.anthropic.com/
#
# HUGGINGFACE:
#   Access to many open models via cloud API
#   Free tier available; rate-limited
#   Get key: https://huggingface.co/settings/tokens
# =============================================================================
