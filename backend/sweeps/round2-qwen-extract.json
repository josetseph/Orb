{
  "name": "round2-qwen-extract",
  "dataset": "hotpotqa",
  "dev": [
    0,
    20
  ],
  "baseline": {
    "EMBED_MODEL_ID": "qwen3-embed-8b-q4",
    "RERANK_MODEL_ID": "qwen3-rerank-8b-q4",
    "EXTRACTION_JSON_CONSTRAINED": false,
    "chat_model": "gemma4-e4b-q4",
    "ingestion_model": "qwen35-4b-q4",
    "EXTRACTION_ENABLE_THINKING": false
  },
  "evaluator": "full",
  "metric": "answer_f1",
  "vary": {
    "ingestion_model": [
      "qwen35-9b-q4",
      "qwen35-2b-q4"
    ],
    "EXTRACTION_JSON_CONSTRAINED": [
      true
    ]
  },
  "_note": "Qwen 3.5 as the extractor with thinking off through the chat template (enable_thinking=false; /no_think in the prompt is ignored by Qwen 3.5); and with the JSON grammar.",
  "design": "one-at-a-time"
}
