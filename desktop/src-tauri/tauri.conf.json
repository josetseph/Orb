{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orb",
  "version": "1.1.0",
  "identifier": "com.josetseph.orb",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "../build/entitlements.mac.plist",
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2QzE4NDkyRDU5N0IwOTkKUldTWnNKZlZrb1RCNWptdUhua05kSm04TTBZOFRYZEQ5ZkhPQlpjYU9hbXpzVTU2R2JxblM1LzcK",
      "endpoints": [
        "https://github.com/josetseph/Orb/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
